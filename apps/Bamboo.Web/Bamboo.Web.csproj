<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Bamboo.Web</RootNamespace>
    <AssetTargetFallback>$(AssetTargetFallback);portable-net45+win8+wp8+wpa81;</AssetTargetFallback>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <MvcRazorExcludeRefAssembliesFromPublish>false</MvcRazorExcludeRefAssembliesFromPublish>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>Bamboo-4681b4fd-151f-4221-84a4-929d86723e4c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DistributedLock.Redis" Version="1.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.4.0-preview" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Autofac" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.DistributedLocking" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.Client" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.AspNetCore.Authentication.OpenIdConnect" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.Http.Client.Web" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.Http.Client.IdentityModel.Web" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.Identity.Web" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.TenantManagement.Web" Version="10.4.0-rc.1" />
    <PackageReference Include="Volo.Abp.SettingManagement.Web" Version="10.4.0-rc.1" />
    <!-- <ProjectReference Include="..\Bamboo.HttpApi.Client\Bamboo.HttpApi.Client.csproj" /> -->
    <!-- <ProjectReference Include="..\Bamboo.HttpApi\Bamboo.HttpApi.csproj" /> -->
  </ItemGroup>

  <ItemGroup>
    <!-- <ProjectReference Include="..\..\shared\admin\Bamboo.Admin.HttpApi.Client\Bamboo.Admin.HttpApi.Client.csproj" /> -->
    <ProjectReference Include="..\..\services\admin\src\Bamboo.Admin.HttpApi.Client\Bamboo.Admin.HttpApi.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\common\Bamboo.Shared.Common\Bamboo.Shared.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Pages\**\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Pages\**\*.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
