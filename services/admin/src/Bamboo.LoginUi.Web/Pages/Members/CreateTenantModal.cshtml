@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Bamboo.Admin.Localization
@inject IHtmlLocalizer<AdminResource> L
@model Bamboo.Abp.LoginUi.Web.Pages.Admin.Members.CreateTenantModalModel

@{
    Layout = null;
}
<form method="post" action="@Url.Page("./CreateTenantModal")">
    <abp-modal>
        <abp-modal-header title="@L["CreateTenant"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-form id="createTenantForm">
                <abp-input asp-for="Tenant.Name" pattern="^[a-z0-9]+$" minlength="5" title="@L["TenantNameRequirements"]" />
                <div class="form-text text-muted mb-3">@L["TenantNameRequirements"]</div>
                <abp-input asp-for="Tenant.AdminEmailAddress" />
                <abp-input asp-for="Tenant.AdminPassword" type="password" />
            </abp-form>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
<script src="/Pages/Members/createTenantModal.js"></script>