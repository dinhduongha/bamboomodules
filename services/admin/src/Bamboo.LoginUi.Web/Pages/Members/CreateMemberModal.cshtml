@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.MultiTenancy
@using Bamboo.Admin.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Bamboo.Abp.LoginUi.Web.Pages.Admin.Members.CreateMemberModalModel
@inject IHtmlLocalizer<AdminResource> L
@{
    Layout = null;
}
<abp-modal>
    <abp-modal-header title="@L["CreateMember"].Value"></abp-modal-header>
    <abp-modal-body>
        <abp-form id="createMemberForm">
            @if (!Model.CurrentTenant.IsAvailable)
            {
                <abp-select asp-for="Member.TenantId" asp-items="Model.Tenants" label="@L["Tenant"].Value"/>
            }
            <abp-lookup-input asp-for="Member.UserId" lookup-url="/api/identity/users/lookup" label="@L["User"].Value"/>
            <abp-select asp-for="Member.Roles" asp-items="Model.Roles" label="@L["Roles"].Value" multiple="true"/>
        </abp-form>
    </abp-modal-body>
    <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
</abp-modal>
<script src="/Pages/Members/createMemberModal.js"></script>