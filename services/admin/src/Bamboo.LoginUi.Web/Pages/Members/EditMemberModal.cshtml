@page
@using Bamboo.Admin.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Volo.Abp.MultiTenancy

@model Bamboo.Abp.LoginUi.Web.Pages.Admin.Members.EditMemberModalModel
@inject IHtmlLocalizer<AdminResource> L
@inject ICurrentTenant CurrentTenant

@{
    Layout = null;
}
<form method="post" action="@Url.Page("./EditMemberModal")">
<abp-modal data-modal-name="editMemberModal">
    <abp-modal-header title="@L["EditMember"].Value"></abp-modal-header>
        <abp-modal-body>
        <abp-form id="editMemberForm">
            <abp-input asp-for="Member.Id" />
            <abp-input asp-for="Member.UserName" disabled="true" />
            <abp-select asp-for="Member.SelectedRoles" asp-items="Model.AllRoles" label="@L["Roles"].Value" multiple="true"/>
            <abp-select asp-for="Member.Status" asp-items="Model.AllStatuses" label="@L["Status"].Value" />
            <abp-check asp-for="Member.IsActive" label="@L["IsActive"].Value" />
            <abp-textarea asp-for="Member.Description" label="@L["Description"].Value" />
            </abp-form>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>    
</abp-modal>
</form>
<script src="/Pages/Members/editMemberModal.v2.js"></script>