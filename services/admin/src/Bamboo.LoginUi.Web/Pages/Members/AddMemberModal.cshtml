@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.MultiTenancy
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Bamboo.Admin.Localization
@model Bamboo.Abp.LoginUi.Web.Pages.Admin.Members.AddMemberModalModel
@inject IHtmlLocalizer<AdminResource> L
@inject ICurrentTenant CurrentTenant

@{
    Layout = null;
}
<form method="post" action="@Url.Page("./AddMemberModal")">
    <abp-modal data-modal-name="addMemberModal">
        <abp-modal-header title="@L["AddMember"].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-form id="addMemberForm">
                @if (!CurrentTenant.IsAvailable)
                {
                    <abp-select asp-for="Member.TenantId" asp-items="Model.Tenants" label="@L["Tenant"].Value"/>
                }
                <abp-input asp-for="Member.UserId" />
                <abp-input asp-for="Member.Email" />
                <abp-select asp-for="Member.RoleName" asp-items="Model.Roles" label="@L["Roles"].Value"/>

                @* <abp-lookup-input asp-for="Member.UserId" lookup-url="/api/identity/users/lookup" label="@L["User"].Value"/>
                <abp-select asp-for="Member.Roles" asp-items="Model.Roles" label="@L["Roles"].Value" multiple="true"/> *@
            </abp-form>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
<script src="/Pages/Members/addMemberModal.v2.js"></script>