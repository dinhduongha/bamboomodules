@using Bamboo.Abp.LoginUi.Web.Localization
@using Bamboo.Admin.Domain.Shared.Enums
@using Bamboo.Abp.LoginUi.Web.Pages.Account.Workspaces
@using Microsoft.AspNetCore.Mvc.Localization
@model System.Collections.Generic.List<WorkspaceDto>
@inject IHtmlLocalizer<AbpLoginUiResource> L

@{
    string GetStatusClass(TenantMemberStatus status) => status switch
    {
        TenantMemberStatus.Pending => "warning",
        TenantMemberStatus.Active => "success",
        TenantMemberStatus.Disabled => "danger",
        _ => "secondary"
    };

    string GetStatusText(TenantMemberStatus status) => status switch
    {
        TenantMemberStatus.Pending => L[$"Enum:{typeof(TenantMemberStatus).Name}.{status}"].Value,
        TenantMemberStatus.Active => L[$"Enum:{typeof(TenantMemberStatus).Name}.{status}"].Value,
        TenantMemberStatus.Disabled => L[$"Enum:{typeof(TenantMemberStatus).Name}.{status}"].Value,
        _ => status.ToString()
    };
}

<div class="mt-3">
    <h4>@L["MyWorkspaces"]</h4>
    <table class="table table-striped table-bordered mt-3">
        <thead>
            <tr>
                <th>@L["Workspace"]</th>
                <th>@L["Roles"]</th>
                <th>@L["Status"]</th>
                <th>@L["JoinedDate"]</th>
                <th class="text-center">@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var workspace in Model)
            {
                <tr>
                    <td><strong>@workspace.TenantName</strong></td>
                    <td>
                        @foreach (var role in workspace.Roles)
                        {
                            <span class="badge bg-secondary me-1">@role</span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-@GetStatusClass(workspace.Status)">
                            @GetStatusText(workspace.Status)
                        </span>
                    </td>
                    <td>@workspace.JoinedDate?.ToString("d")</td>
                    <td class="text-center">
                        @if (workspace.InviteStatus == InvitationStatus.Pending)
                        {
                            <form method="post" asp-page="/Account/MyInvitations/Index" style="display: inline-block;">
                                <button asp-page-handler="Accept" asp-route-invitationId="@workspace.Id" class="btn btn-success btn-sm">@L["Accept"]</button>
                            </form>
                            <form method="post" asp-page="/Account/MyInvitations/Index" style="display: inline-block;">
                                <button asp-page-handler="Reject" asp-route-invitationId="@workspace.Id" class="btn btn-danger btn-sm">@L["Reject"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>