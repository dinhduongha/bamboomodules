        </div>
        <div class="chain-card" id="btn-cellframe">
            <img src="https://wiki.cellframe.net/uploads/images/gallery/2021-08/scaled-1680-/2R9i6q4vj1g5p3m8-image-1628172827653.png" class="chain-icon" onerror="this.src='https://placehold.co/48?text=CF'">
            <span class="chain-name">CellFrame</span>
