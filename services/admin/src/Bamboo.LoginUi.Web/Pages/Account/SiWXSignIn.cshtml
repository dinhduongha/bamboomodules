        </div>

        <div class="chain-card" id="btn-gnosis">
            <img src="https://cryptologos.cc/logos/gnosis-gno-logo.png" class="chain-icon">
            <span class="chain-name">Gnosis (xDai)</span>
        </div>

        <div class="chain-card" id="btn-polygon">
            <img src="https://cryptologos.cc/logos/polygon-matic-logo.png" class="chain-icon">
            <span class="chain-name">Polygon</span>
        </div>

        <div class="chain-card" id="btn-cosmos">
            <img src="https://cryptologos.cc/logos/cosmos-atom-logo.png" class="chain-icon">
            <span class="chain-name">Cosmos</span>
        </div>

        <div class="chain-card" id="btn-stellar">
            <img src="https://cryptologos.cc/logos/stellar-xlm-logo.png" class="chain-icon">
            <span class="chain-name">Stellar</span>
        </div>


        <div class="chain-card" id="btn-sui">
            <img src="https://cryptologos.cc/logos/sui-sui-logo.png" class="chain-icon">
            <span class="chain-name">Sui Network</span>
        </div>

        <div class="chain-card" id="btn-aptos">
            <img src="https://cryptologos.cc/logos/aptos-apt-logo.png" class="chain-icon">
            <span class="chain-name">Aptos</span>
        </div>
        <div class="chain-card" id="btn-polkadot">
            <img src="https://cryptologos.cc/logos/polkadot-new-dot-logo.png" class="chain-icon">
            <span class="chain-name">Polkadot</span>
        </div>
        <div class="chain-card" id="btn-solana">
            <img src="https://upload.wikimedia.org/wikipedia/en/b/b9/Solana_logo.png" class="chain-icon">
            <span class="chain-name">Solana</span>
        </div>

        @* <div class="chain-card" id="btn-pi">
            <img src="https://seeklogo.com/images/P/pi-network-logo-5946808826-seeklogo.com.png" class="chain-icon">
            <span class="chain-name">Pi Network</span>
        </div> *@
    </div>
    <div class="chain-card" id="btn-walletconnect">
    <img src="https://avatars.githubusercontent.com/u/37784886" class="chain-icon">
    <span class="chain-name">WalletConnect</span>
</div>

</div>
<div id="ton-connect-button" style="display:none;"></div>

<form method="post" id="loginForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SessionHandle" value="@Model.SessionHandle" />
    <input type="hidden" name="siwxJson" id="hSiwxJson" />
    <input type="hidden" name="signature" id="hSignature" />
    <input type="hidden" name="address" id="hAddress" />
    <input type="hidden" name="network" id="hNetwork" />
    <input type="hidden" name="publicKey" id="hPublicKey" />

    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <input type="hidden" name="ReturnUrlHash" value="@Model.ReturnUrlHash" />
</form>

<div id="wallet-selector-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; padding:20px; border-radius:12px; width:300px; max-width:90%;">
        <h5 class="mb-3 text-center">Select your Wallet</h5>
        <div id="wallet-list" class="d-flex flex-column gap-2">
            </div>
        <button class="btn btn-secondary w-100 mt-3" onclick="closeWalletModal()">Cancel</button>
    </div>
</div>

<style>
    .provider-btn {
        display: flex; align-items: center; padding: 10px;
        border: 1px solid #eee; border-radius: 8px; cursor: pointer;
        transition: 0.2s;
    }
    .provider-btn:hover { background: #f8f9fa; border-color: #007bff; }
    .provider-btn img { width: 24px; height: 24px; margin-right: 10px; }
</style>
@section Scripts {
    <script src="https://unpkg.com/tonconnect/ui@latest/dist/tonconnect-ui.min.js"></script>
    <script src="https://unpkg.com/bs58@4.0.1/bundle.js"></script>
    @* THÊM DẤU CHẤM THAN (!) VÀO NGAY TRƯỚC script *@
    <!script type="importmap">
    {
        "imports": {
            "ethers": "https://esm.sh/ethers@5.7.2",
            "siwe": "https://esm.sh/siwe@2.1.4",
            "tonconnect_ui": "https://esm.sh/@@tonconnect/ui@latest",
            "@@web3modal/ethers5": "https://esm.sh/@@web3modal/ethers5@4.0.0",
            "@@polkadot/extension-dapp": "https://esm.sh/@@polkadot/extension-dapp@0.46.6",
            "@@polkadot/util": "https://esm.sh/@@polkadot/util@12.6.2",
            "@@polkadot/util-crypto": "https://esm.sh/@@polkadot/util-crypto@12.6.2"
        }
    }
    </!script>

    <script type="module">
        import { ethers } from 'ethers';
        import { SiweMessage } from 'siwe';
        import { TonConnectUI } from 'tonconnect_ui';
        import { web3Accounts, web3Enable, web3FromSource } from '@@polkadot/extension-dapp';
        import { stringToHex } from '@@polkadot/util';
        // Import Web3Modal
        import { createWeb3Modal, defaultConfig } from '@@web3modal/ethers5';

        const nonce = "@nonce";
        const domain = window.location.host;
        const origin = window.location.origin;
        const issuedAt = new Date().toISOString();
        const useEip6963 = @Json.Serialize(Model.EnableEip6963);
        const useWalletConnect = @Json.Serialize(Model.EnableWalletConnect);
        const wcProjectId = "@Model.WalletConnectProjectId";

        // --- EIP-6963 STORE ---
        let eip6963Providers = []; // Danh sách ví EIP-6963 tìm thấy
        let tonConnectUI;
        let wcModal;
        const wcChains = @Json.Serialize(Model.WalletConnectChains);

        // --- HELPER TẠO SIWX TEXT (Chuẩn EIP-4361 cho mọi Chain) ---
        function createSiwxText(params) {
            const { domain, address, statement, uri, version, chainId, nonce, issuedAt } = params;
            
            let msg = `${domain} wants you to sign in with your account:\n`;
            msg += `${address}\n\n`;
            
            if (statement) {
                msg += `${statement}\n\n`;
            }
            
            msg += `URI: ${uri}\n`;
            msg += `Version: ${version}\n`;
            msg += `Chain ID: ${chainId}\n`;
            msg += `Nonce: ${nonce}\n`;
            msg += `Issued At: ${issuedAt}`;
            
            return msg;
        }

        function createSiwxDto(address, chainId, msgText) {
            return {
                domain, 
                address, 
                statement: "Sign in to Web3", 
                uri: origin, 
                version: "1", 
                chainId: chainId.toString(), 
                nonce, 
                issuedAt
                // msgText dùng để ký ở client, còn object này để server validate
            };
        }

        // --- 1. KHỞI TẠO WALLET CONNECT ---
        if (useWalletConnect && wcProjectId) {
            const metadata = {
                name: 'Web3 App',
                description: 'Web3 Login',
                url: window.location.origin,
                icons: ['https://avatars.githubusercontent.com/u/37784886']
            }
            try {
            // KHỞI TẠO VỚI DANH SÁCH ĐỘNG
            wcModal = createWeb3Modal({
                ethersConfig: defaultConfig({ metadata }),
                
                // Thay vì hardcode [mainnet], ta dùng biến wcChains
                chains: wcChains, 
                
                projectId: wcProjectId,
                enableAnalytics: true
            });
            } catch (e) { 
                console.error(e); 
                alert("WalletConnect Error: " + e.message); 
                document.getElementById('btn-walletconnect').style.display = 'none';
            }
        }

        // --- 2. EIP-6963 ---
        if (useEip6963) {
            window.addEventListener("eip6963:announceProvider", (event) => {
                const p = event.detail;
                if (!eip6963Providers.some(x => x.info.uuid === p.info.uuid)) {
                    eip6963Providers.push(p);
                }
            });
            window.dispatchEvent(new Event("eip6963:requestProvider"));
        }

        function setStatus(msg) {
            document.getElementById("clientStatus").innerHTML = `<div class="alert alert-info">${msg}</div>`;
        }

        // ==========================================
        // HÀM LOGIN WALLETCONNECT
        // ==========================================
        // --- B. WALLET CONNECT LOGIN ---
        async function wcLogin() {
            if (!wcModal) return alert("WalletConnect disabled.");
            try {
                await wcModal.open();
                const unsubscribe = wcModal.subscribeProvider(async ({ provider, address, chainId }) => {
                    if (provider && address) {
                        unsubscribe();
                        wcModal.close();
                        
                        const ethersProvider = new ethers.providers.Web3Provider(provider);
                        const signer = ethersProvider.getSigner();
                        const message = new SiweMessage({
                            domain, address, statement: "WC Login", uri: origin, version: "1", chainId: chainId || 1, nonce, issuedAt
                        });
                        const msgText = message.prepareMessage();
                        const signature = await signer.signMessage(msgText);
                        
                        submitLogin("walletconnect", address, message, signature);
                    }
                });
            } catch (e) { console.error(e); }
        }

        async function walletConnectLogin() {
            if (!wcModal) return alert("WalletConnect is disabled or missing Project ID.");

            try {
                // 1. Mở Modal để user quét QR hoặc chọn ví
                await wcModal.open();

                // 2. Lắng nghe trạng thái kết nối
                // Web3Modal v4 Ethers5 không trả về promise khi connect xong ngay lập tức ở hàm open().
                // Ta phải theo dõi Provider của nó.
                
                const unsubscribe = wcModal.subscribeProvider(async ({ provider, address, chainId }) => {
                    if (provider && address) {
                        // KẾT NỐI THÀNH CÔNG -> TIẾN HÀNH KÝ
                        
                        // Ngắt lắng nghe để tránh gọi lại nhiều lần
                        unsubscribe(); 
                        wcModal.close(); // Đóng modal

                        try {
                            console.log("WalletConnect connected:", address);
                            
                            // Tạo Web3Provider từ Provider của WalletConnect
                            const ethersProvider = new ethers.providers.Web3Provider(provider);
                            const signer = ethersProvider.getSigner();
                            
                            // Tạo Message SIWE
                            const message = new SiweMessage({
                                domain, address, 
                                statement: "Login via WalletConnect", 
                                uri: origin, version: "1", chainId: chainId || 1, nonce, issuedAt
                            });
                            
                            const messageText = message.prepareMessage();
                            const signature = await signer.signMessage(messageText);

                            submitLogin("walletconnect", address, messageText, signature);
                            
                        } catch (err) {
                            console.error(err);
                            alert("Sign Error: " + err.message);
                            // Nếu ký lỗi, nên disconnect để lần sau làm lại từ đầu
                            await wcModal.disconnect();
                        }
                    }
                });

            } catch (e) { console.error(e); }
        }

        function submitLogin(net, addr, messageObj, sig, pubKey = "") {
            document.getElementById("hNetwork").value = net;
            document.getElementById("hAddress").value = addr;
            document.getElementById("hSiwxJson").value = JSON.stringify(messageObj);;
            document.getElementById("hSignature").value = sig;
            document.getElementById("hPublicKey").value = pubKey;
            document.getElementById("loginForm").submit();
        }
        
        
        // --- HELPER MODAL ---
        window.closeWalletModal = () => {
            document.getElementById('wallet-selector-modal').style.display = 'none';
        };


        @* function showWalletSelector(net, chainId, callback) {
            const list = document.getElementById('wallet-list');
            list.innerHTML = ''; // Clear cũ

            discoveredProviders.forEach(p => {
                const btn = document.createElement('div');
                btn.className = 'provider-btn';
                btn.innerHTML = `<img src="${p.info.icon}" alt="${p.info.name}"> <span>${p.info.name}</span>`;
                btn.onclick = () => {
                    closeWalletModal();
                    callback(p.provider); // Gọi callback với provider được chọn
                };
                list.appendChild(btn);
            });

            document.getElementById('wallet-selector-modal').style.display = 'flex';
        } *@

        // Modal Selector cho EIP-6963
        function showWalletModal(callback) {
            const modal = document.getElementById('wallet-selector-modal');
            const list = document.getElementById('wallet-list');
            list.innerHTML = '';

            eip6963Providers.forEach(p => {
                const item = document.createElement('div');
                item.className = 'provider-btn';
                item.innerHTML = `<img src="${p.info.icon}" alt="${p.info.name}"/> <span>${p.info.name}</span>`;
                item.onclick = () => {
                    modal.style.display = 'none';
                    callback(p.provider);
                };
                list.appendChild(item);
            });

            modal.style.display = 'flex';
        }

        document.addEventListener('DOMContentLoaded', () => {
            console.log("Web3 Script Loaded & Ready");
            try {
                const buttonRoot = document.getElementById('ton-connect-button');
                if (buttonRoot) {
                    tonConnectUI = new TonConnectUI({
                        manifestUrl: window.location.origin + '/tonconnect-manifest.json',
                        buttonRootId: 'ton-connect-button'
                    });
                } else {EnableEip6963 = _configuration.GetValue<bool>("Blockchain:EnableEip6963");

                    console.warn("Missing div #ton-connect-button");
                }
            } catch (e) {
                console.error("TON Init Error:", e);
            }

            // Hàm helper để gắn sự kiện cho gọn code
            const attach = (id, callback) => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('click', callback);
            };

            // 1. EVM Group
            attach('btn-eth',     () => evmLogin('ethereum', 1));
            attach('btn-bnb',     () => evmLogin('bnb', 56));
            attach('btn-gnosis',  () => evmLogin('gnosis', 100));
            attach('btn-polygon', () => evmLogin('polygon', 137));

            // 2. Solana
            attach('btn-solana',  () => solanaLogin());

            // 3. Stellar Family
            attach('btn-stellar', () => stellarLogin('stellar'));
            attach('btn-pi',      () => stellarLogin('pi-network'));

            // 4. Move Language (Sui / Aptos)
            attach('btn-sui',     () => suiLogin());
            attach('btn-aptos',   () => aptosLogin());

            // 5. Others
            attach('btn-ton',       () => tonLogin());
            attach('btn-cosmos',    () => cosmosLogin());
            attach('btn-cellframe', () => cellframeLogin());
            attach('btn-polkadot', () => polkadotLogin());
            attach('btn-walletconnect', () => wcLogin());
            //attach('btn-walletconnect', () => walletConnectLogin());
        });
    
        // --- 1. EVM ---
        window.evmLogin = async function evmLogin(net, chainId) {
            const connectAndSign = async (providerObj) => {
                try {
                    setStatus(`Connecting ${net}...`);
                    // Web3Provider của Ethers v5 nhận bất kỳ EIP-1193 Provider nào
                    const provider = new ethers.providers.Web3Provider(providerObj);
                    
                    await provider.send("eth_requestAccounts", []);
                    const signer = provider.getSigner();
                    const address = await signer.getAddress();

                    try {
                        await provider.send('wallet_switchEthereumChain', [{ chainId: ethers.utils.hexValue(chainId) }]);
                    } catch {}

                    const message = new SiweMessage({
                        domain, address, statement: "Login Web3", uri: origin, version: "1", chainId: chainId, nonce, issuedAt
                    });
                    const msgText = message.prepareMessage();
                    const signature = await signer.signMessage(msgText);
                    console.log("Message:", msgText);
                    console.log("Signature:", signature);
                    submitLogin(net, address, message, signature);
                } catch (e) {
                    alert("Error: " + (e.reason || e.message));
                }
            };

            // Logic chọn ví
            if (useEip6963 && eip6963Providers.length > 1) {
                // Nhiều ví -> Hiện modal chọn
                showWalletModal((selectedProvider) => connectAndSign(selectedProvider));
            } else if (useEip6963 && eip6963Providers.length === 1) {
                // 1 ví -> Dùng luôn
                connectAndSign(eip6963Providers[0].provider);
            } else if (window.ethereum) {
                // Fallback cũ
                connectAndSign(window.ethereum);
            } else {
                alert("Please install MetaMask!");
            }
        }

        // --- 2. SOLANA ---
        window.solanaLogin = async function solanaLogin() {
            const provider = window.solana || window.backpack;
            if (!provider) return alert("Install Phantom Wallet!");
            try {
                setStatus("Connecting Solana...");
                await provider.connect();
                const addr = provider.publicKey.toString();

                // 1. Tạo nội dung chuẩn SIWE
                const siwxParams = {
                    domain, address: addr, statement: "Sign in to Web3", 
                    uri: origin, version: "1", chainId: "solana", nonce, issuedAt
                };
                const msgText = createSiwxText(siwxParams);

                // 2. Ký Message (Encode UTF8)
                const encMsg = new TextEncoder().encode(msgText);
                const signed = await provider.signMessage(encMsg, "utf8");
                const sig = bs58.encode(signed.signature);

                // 3. Submit (Gửi kèm Object DTO)
                submitLogin("solana", addr, siwxParams, sig);

            } catch (e) { alert(e.message); }
        }

        // --- 3. CELLFRAME (NEW) ---
        window.cellframeLogin = async function cellframeLogin() {
            // CellFrame thường chạy dashboard extension hoặc local node
            // Giả lập logic kết nối vì CellFrame chưa có chuẩn window.cellframe phổ biến như Metamask
            // Nếu bạn có JS SDK riêng của CellFrame, hãy thay vào đây.
            
            if (!window.cellframe) {
                // Demo mode cho CellFrame nếu chưa cài ext
                alert("CellFrame Extension not detected. (Checking local node...)");
                // Logic thực tế: Gọi Local API localhost:8089 hoặc extension
                return;
            }

            try {
                setStatus("Connecting CellFrame...");
                // Giả định API của CellFrame Wallet extension
                const wallet = await window.cellframe.connect(); 
                const addr = wallet.address; 
                const msgText = `Login ${domain} Nonce:${nonce}`;
                
                // Ký bằng Post-Quantum key
                const sig = await window.cellframe.sign(msgText); 
                
                submitLogin("cellframe", addr, msgText, sig);
            } catch (e) { 
                alert("CellFrame Error: " + e.message); 
            }
        }

        // --- 4. STELLAR / PI ---
        window.stellarLogin = async function stellarLogin(net) {
            if (!window.freighterApi?.isConnected) return alert("Install Freighter!");
            try {
                setStatus(`Connecting ${net}...`);
                const info = await window.freighterApi.getAddress();
                const addr = info.publicKey;

                // ChainID của Stellar Mainnet là 'Public Global...' nhưng để ngắn gọn ta dùng 'stellar'
                // hoặc dùng Network Passphrase thật nếu muốn chặt chẽ.
                const siwxParams = {
                    domain, address: addr, statement: "Sign in to Web3", 
                    uri: origin, version: "1", chainId: "stellar-mainnet", nonce, issuedAt
                };
                const msgText = createSiwxText(siwxParams);

                const signedBlob = await window.freighterApi.signMessage(msgText);
                const sig = btoa(String.fromCharCode(...new Uint8Array(signedBlob)));
                
                submitLogin(net, addr, siwxParams, sig);
            } catch (e) { alert(e.message); }
        }

        // --- 5. APTOS ---
        async function aptosLogin() {
             if (!window.aptos) return alert("Install Petra Wallet!");
             try {
                setStatus("Connecting Aptos...");
                const acc = await window.aptos.connect();
                
                const siwxParams = {
                    domain, address: acc.address, statement: "Sign in to Web3", 
                    uri: origin, version: "1", chainId: "aptos:1", nonce, issuedAt
                };
                const msgText = createSiwxText(siwxParams);

                // Aptos signMessage nhận object
                const msgPayload = { 
                    message: msgText, 
                    nonce: nonce // Aptos SDK có trường nonce riêng, nhưng ta cứ đưa text full vào message
                };
                
                const signed = await window.aptos.signMessage(msgPayload);
                submitLogin("aptos", acc.address, siwxParams, signed.signature, acc.publicKey);
            } catch (e) { alert(e.message); }
        }
        
        // --- 6. COSMOS ---
        window.cosmosLogin = async function cosmosLogin() {
            if (!window.keplr) return alert("Install Keplr");
            try {
                const cid = "cosmoshub-4";
                await window.keplr.enable(cid);
                const off = window.keplr.getOfflineSigner(cid);
                const accs = await off.getAccounts();
                
                //const msgText = `Login ${domain} Nonce:${nonce}`;
                const siwxParams = {
                    domain, address: acc.address, statement: "Sign in to Web3", 
                    uri: origin, version: "1", chainId: "aptos:1", nonce, issuedAt
                };
                const msgText = createSiwxText(siwxParams);
                
                const res = await window.keplr.signArbitrary(cid, accs[0].address, msgText);
                submitLogin("cosmos", accs[0].address, msgText, res.signature, res.pub_key.value);
            } catch (e) { alert(e.message); }
        }

        window.suiLogin = async function suiLogin() {
            const wallet = window.suiWallet;
            if (!wallet) return alert("Install Sui Wallet!");
            try {
                setStatus("Connecting Sui...");
                if (!await wallet.hasPermissions()) await wallet.requestPermissions();
                const accounts = await wallet.getAccounts();
                const addr = accounts[0].address;

                const siwxParams = {
                    domain, address: addr, statement: "Sign in to Web3", 
                    uri: origin, version: "1", chainId: "sui:mainnet", nonce, issuedAt
                };
                const msgText = createSiwxText(siwxParams);
                const msgBytes = new TextEncoder().encode(msgText); // Sui cần bytes

                const result = await wallet.signPersonalMessage({ message: msgBytes });
                
                // Lưu ý: Sui trả về signature gộp, cần backend xử lý tách như bài trước
                submitLogin("sui", addr, siwxParams, result.signature, ""); 
            } catch (e) { alert(e.message); }
        }

        window.tonLogin = async function tonLogin() {
            try {
                setStatus("Connecting TON...");
                
                // Nếu đã connect thì disconnect trước để login lại
                if (tonConnectUI.connected) {
                    await tonConnectUI.disconnect();
                }

                // Mở Modal chọn ví
                await tonConnectUI.openModal();

                // Lắng nghe sự kiện status change
                const unsubscribe = tonConnectUI.onStatusChange(async (wallet) => {
                    if (wallet) {
                        const address = wallet.account.address; // Raw address
                        const publicKey = wallet.account.publicKey; // Hex string
                        
                        // TON Challenge:
                        // TonConnect chuẩn dùng 'ton_proof' (phức tạp).
                        // Để login nhanh kiểu "ký text", hiện tại TonConnect UI chưa support hàm signMessage text raw một cách native dễ dàng như Metamask.
                        // Nó support signData.
                        
                        // Giải pháp tạm: Lấy publicKey từ wallet object gửi về server. 
                        // Server tạm chấp nhận login bằng việc "User sở hữu wallet có publicKey này".
                        // (Mức độ bảo mật thấp hơn sign message vì không có Nonce challenge thực sự từ chữ ký, 
                        // nhưng TonConnect có proof nonce riêng trong payload kết nối).
                        
                        // Nếu muốn bảo mật cao: Phải implement check `ton_proof` ở backend.
                        // Ở đây tôi gửi proof nonce của TON về làm signature giả lập.
                        
                        const proof = wallet.connectItems?.tonProof;
                        if(proof) {
                             submitLogin("ton", address, "TonProofLogin", proof.signature, publicKey);
                        } else {
                            // Fallback: Chỉ gửi pubkey (Bảo mật thấp)
                             submitLogin("ton", address, "NoSig", "EMPTY", publicKey);
                        }
                        unsubscribe();
                    }
                });

            } catch (e) { alert("TON Error: " + e.message); }
        }
        // ==========================================
        // POLKADOT LOGIN
        // ==========================================
        async function polkadotLogin() {
            try {
                setStatus("Connecting Polkadot...");

                // 1. Kích hoạt Extension (Talisman, SubWallet, Polkadot.js...)
                const extensions = await web3Enable('My Web3 App');
                if (extensions.length === 0) {
                    return alert("Please install Polkadot.js, Talisman or SubWallet extension!");
                }

                // 2. Lấy danh sách tài khoản
                const allAccounts = await web3Accounts();
                if (allAccounts.length === 0) {
                    return alert("No accounts found in wallet.");
                }

                // Mặc định lấy tài khoản đầu tiên (hoặc bạn có thể làm Modal chọn như EIP-6963)
                const account = allAccounts[0];
                const address = account.address;
                const injector = await web3FromSource(account.meta.source);

                // 3. Tạo Message chuẩn SIWX
                const siwxParams = {
                    domain, address: address, statement: "Sign in to Web3", 
                    uri: origin, version: "1", chainId: "polkadot", nonce, issuedAt
                };
                const msgText = createSiwxText(siwxParams);

                // 4. Ký Message (Sign Raw)
                // Lưu ý: Polkadot signRaw yêu cầu message dạng Hex hoặc Bytes, và nó sẽ bọc trong <Bytes>...</Bytes>
                const signRaw = injector.signer.signRaw;
                
                if (!signRaw) return alert("Wallet does not support signRaw");

                const { signature } = await signRaw({
                    address: address,
                    data: stringToHex(msgText), // Chuyển text sang Hex để ký
                    type: 'bytes'
                });

                // Gửi về server
                submitLogin("polkadot", address, siwxParams, signature);

            } catch (e) {
                console.error(e);
                alert("Polkadot Error: " + e.message);
            }
        }
    </script>
}