@page "/Account/Workspaces"
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Bamboo.Abp.LoginUi.Web.Localization
@using Bamboo.Admin.Domain.Shared.Enums
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@using Volo.Abp.Authorization
@using Volo.Abp.Users 

@model Bamboo.Abp.LoginUi.Web.Pages.Account.Workspaces.IndexModel
@inject IThemeManager ThemeManager
@inject IHtmlLocalizer<AbpLoginUiResource> L
@inject IPageLayout PageLayout
@inject ICurrentUser CurrentUser 

@{
    Layout = ThemeManager.CurrentTheme.GetApplicationLayout();
    PageLayout.Content.Title = L["Workspaces"].Value;
    PageLayout.Content.BreadCrumb.Add(L["Workspaces"].Value);

    // Helper hiển thị màu trạng thái
    string GetStatusClass(TenantMemberStatus status) => status switch
    {
        TenantMemberStatus.Pending => "warning",
        TenantMemberStatus.Active => "success",
        TenantMemberStatus.Disabled => "secondary",
        _ => "secondary"
    };

    // Helper hiển thị tên trạng thái
    string GetStatusText(TenantMemberStatus status) => status switch
    {
        TenantMemberStatus.Pending => L["Enum:TenantMemberStatus.Pending"].Value,
        TenantMemberStatus.Active => L["Enum:TenantMemberStatus.Active"].Value,
        TenantMemberStatus.Disabled => L["Enum:TenantMemberStatus.Rejected"].Value, // Hoặc Disabled
        _ => status.ToString()
    };
}

<abp-card>
    <abp-card-header>
        <div class="row align-items-center">
            <div class="col-md-6">
                <form method="get" class="input-group">
                    <input type="text" class="form-control" name="Filter" value="@Model.Filter" placeholder="@L["Search..."]">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i></button>
                </form>
            </div>
            
            <div class="col-md-6 text-end">
                @if (CurrentUser.TenantId != null)
                {
                    <form action="Workspaces/Switch" method="post" style="display:inline-block">
                        <input type="hidden" name="targetTenantId" value="" /> <button type="submit" class="btn btn-warning">
                            <i class="fa fa-home"></i> @L["SwitchToHost"]
                        </button>
                    </form>
                }
                else
                {
                    <span class="badge bg-info p-2">@L["YouAreInHost"]</span>
                }
                <span class="badge bg-info p-2">@L["CreateTenant"]</span>
            </div>
        </div>
    </abp-card-header>

    <abp-card-body>
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>@L["Workspace"]</th>
                        <th>@L["Roles"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["JoinedDate"]</th>
                        <th class="text-center" style="width: 200px;">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Workspaces.Items.Any())
                    {
                        @foreach (var workspace in Model.Workspaces.Items)
                        {
                            // Kiểm tra xem đây có phải tenant đang đăng nhập không
                            var isCurrentTenant = CurrentUser.TenantId == workspace.TenantId;
                            var rowClass = isCurrentTenant ? "table-primary" : "";

                            <tr class="@rowClass">
                                <td>
                                    <strong>@workspace.TenantName</strong>
                                    @if (workspace.IsOwner)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Owner</span>
                                    }
                                    @if (isCurrentTenant)
                                    {
                                        <span class="badge bg-primary ms-1">Current</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in workspace.Roles)
                                    {
                                        <span class="badge bg-secondary me-1">@role</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@GetStatusClass(workspace.Status)">
                                        @GetStatusText(workspace.Status)
                                    </span>
                                </td>
                                <td>@workspace.JoinedDate?.ToString("d")</td>
                                <td class="text-center">
                                    @if (workspace.InviteStatus == InvitationStatus.Pending)
                                    {
                                        // --- TRƯỜNG HỢP 1: LỜI MỜI (ACCEPT / REJECT) ---
                                        // Gọi về PageHandler của file Index.cshtml.cs
                                        <form method="post" class="d-inline-block">
                                            <button asp-page-handler="Accept" asp-route-invitationId="@workspace.Id" 
                                                    class="btn btn-success btn-sm" title="@L["Accept"]">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </form>
                                        <form method="post" class="d-inline-block ms-1">
                                            <button asp-page-handler="Reject" asp-route-invitationId="@workspace.Id" 
                                                    class="btn btn-danger btn-sm" title="@L["Reject"]"
                                                    onclick="return confirm('@L["AreYouSureReject"]');">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (workspace.Status == TenantMemberStatus.Active)
                                    {
                                        // --- TRƯỜNG HỢP 2: ĐÃ LÀ MEMBER (SWITCH TENANT) ---
                                        if (isCurrentTenant)
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled>
                                                @L["Current"]
                                            </button>
                                        }
                                        else
                                        {
                                            // Gọi Controller TenantSwitchController
                                            <form action="Workspaces/Switch" method="post" class="d-inline-block">
                                                <input type="hidden" name="targetTenantId" value="@workspace.TenantId" />
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    @L["Switch"] <i class="fa fa-arrow-right"></i>
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted p-4">
                                @L["NoWorkspacesFound"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="?Filter=@Model.Filter&CurrentPage=@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?Filter=@Model.Filter&CurrentPage=@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?Filter=@Model.Filter&CurrentPage=@(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </abp-card-body>
</abp-card>