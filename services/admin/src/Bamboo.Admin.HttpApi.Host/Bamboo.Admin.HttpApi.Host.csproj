<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Bamboo.Admin</RootNamespace>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>Bamboo.Admin-4681b4fd-151f-4221-84a4-929d86723e4c</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'Bamboo.Admin.HttpApi.Host' " />
  <ItemGroup>
    <PackageReference Include="Rebus.ServiceProvider" Version="10.5.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="DistributedLock.Redis" Version="1.1.1" />
    <PackageReference Include="Volo.Abp.AspNetCore.Authentication.JwtBearer" Version="10.0.0-rc.3" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.MultiTenancy" Version="10.0.0-rc.3" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.0.0-rc.3" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" Version="10.0.0-rc.3" />
    <PackageReference Include="Volo.Abp.DistributedLocking" Version="10.0.0-rc.3" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.0.0-rc.3" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.0.0-rc.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bamboo.Admin.Application\Bamboo.Admin.Application.csproj" />
    <ProjectReference Include="..\Bamboo.Admin.EntityFrameworkCore\Bamboo.Admin.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Bamboo.Admin.HttpApi\Bamboo.Admin.HttpApi.csproj" />
    <ProjectReference Include="..\Bamboo.AdminExtensions\Bamboo.AdminExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

</Project>
